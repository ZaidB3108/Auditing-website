NODE_ENV=production
PORT=3001
# Use one approach only. DATABASE_URL is convenient for a custom Secrets Manager secret.
# When TLS is enabled, PGSSLROOTCERT must point to the AWS RDS CA bundle in the container.
# DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/handshake_audit
# Recommended: inject fields from an RDS-managed Secrets Manager credential into these variables.
# PGHOST=DATABASE_HOST
# PGPORT=5432
# PGDATABASE=handshake_audit
# PGUSER=DATABASE_USER
# PGPASSWORD=DATABASE_PASSWORD
# Keep this only in Secrets Manager in deployed environments. All new auditors
# receive it once and must replace it on their first sign-in.
INITIAL_AUDITOR_PASSWORD=SET_FROM_SECRETS_MANAGER
PGSSLMODE=verify-full
PGSSLROOTCERT=/app/rds-global-bundle.pem
CORS_ORIGIN=https://audit.compass-usa.com
